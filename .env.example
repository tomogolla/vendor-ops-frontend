# Copy to .env (never commit .env).

# Where `npm run dev` forwards /api requests (the Django runserver).
API_PROXY_TARGET=http://localhost:8000

# Base URL the browser uses for the API. Keep the default (same origin) unless the API is
# served from another domain, in which case also set CORS/CSRF origins on the backend.
VITE_API_BASE=/api/v1
