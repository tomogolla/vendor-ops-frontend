# Copy to .env (never commit .env).

# Where `npm run dev` forwards /api requests (the Django runserver).
API_PROXY_TARGET=http://localhost:8000

# Base URL the browser uses for the API. Keep the default (same origin) unless the API is
# served from another domain, in which case also set CORS/CSRF origins on the backend.
VITE_API_BASE=/api/v1

# Public application form (/apply): the Cloudflare Turnstile SITE key (public; the secret key lives
# only in the backend environment). Local development: Cloudflare's test site key below always
# passes and pairs with the backend test secret 1x0000000000000000000000000000000AA. Production: the
# site key of the Managed widget for ops.thegoodflea.com, set as the VITE_TURNSTILE_SITE_KEY variable
# for the frontend build. Without a real key the form says it is unavailable and cannot be sent.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
